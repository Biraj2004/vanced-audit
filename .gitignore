# ==============================================================================
# Git Ignore Configuration - Defensive Mobile Malware Audit Repository
# ==============================================================================

# Android and Binary Artifacts (GitHub file size limit: 100MB)
*.apk
*.aab
*.dex
*.jar
*.so
*.aar

# Archive formats
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Partial downloads and temporary download markers
*.part
*.part.meta
*.crdownload

# Tested APK binaries (keep directory metadata, ignore large APKs)
apks-tested/*
!apks-tested/.gitignore
!apks-tested/README.md

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
*.log
.pytest_cache/

# Decompilation and tooling output
jadx-bin/
decompiled/
.system_generated/
rea-temp/
node_modules/

# Operating System artifacts
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Whitelist all audit reports, ledgers, and documentation
!*.md
!*.csv
!*.txt
!*.json

